# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o .env de verdade (já está no .gitignore).

# --- Telegram (conta pessoal, via Telethon) ---
# Obtenha em https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+55...

# Nome (título) do canal/grupo a monitorar, exatamente como aparece no Telegram.
# Ex: "Signal Tracker Club"
TELEGRAM_SOURCE_CHAT_TITLE=Signal Tracker Club

# --- Bot de aprovação (DM separada, criado via @BotFather) ---
# Este bot te manda o sinal parseado e espera você clicar Aprovar/Rejeitar.
APPROVAL_BOT_TOKEN=
# Seu chat_id pessoal (fale com @userinfobot para descobrir o seu)
APPROVAL_CHAT_ID=

# Segundos que o bot espera sua aprovação antes de expirar o sinal
APPROVAL_TIMEOUT_SECONDS=300

# --- Binance ---
# true = usa testnet.binancefuture.com (dinheiro fake). Comece sempre com true.
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trava extra independente do testnet: se true, NENHUMA ordem real é enviada,
# apenas logada. Só desligue quando tiver validado tudo em testnet.
DRY_RUN=true

# --- Gestão de risco ---
# % do saldo da carteira arriscado por trade (baseado na distância até o stop)
MAX_RISK_PER_TRADE_PCT=1.0
# Alavancagem máxima permitida, mesmo que o sinal peça mais
MAX_LEVERAGE=5
# R/R mínimo aceito (recompensa do alvo 1 / risco do stop). Sinais abaixo disso são
# automaticamente rejeitados antes mesmo de chegar pra sua aprovação.
MIN_RR_RATIO=1.0
# Máximo de posições abertas simultâneas geridas pelo bot
MAX_CONCURRENT_POSITIONS=3
# Lista opcional de moedas permitidas, separadas por vírgula (vazio = todas)
COIN_WHITELIST=
